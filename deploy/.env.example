# 云端部署统一配置。复制为本目录 .env 后填写；不再读取 backend/.env 或 agent-service/.env。
# 不要提交真实 .env。API Key/Secret Key 含 $ 时使用单引号包住整个值。
COMPOSE_PROJECT_NAME=woda-design
TZ=Asia/Shanghai

# 浏览器访问的完整来源，不带末尾 / 或路径；配置域名 HTTPS 时也要同步修改这里。
PUBLIC_URL=http://localhost:8080
# ERP 美工中心保留在原后端，填写容器可访问的服务根地址（不带 /api/v1）。
ERP_PYTHON_UPSTREAM=http://host.docker.internal:8848
ERP_JAVA_UPSTREAM=http://host.docker.internal:8080
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080

# SDS-design 后端注册到独立 Nacos 服务器，默认关闭。
# 启用后首次注册失败会阻止后端启动；需同时放通 18848 和 19848。
NACOS_ENABLED=false
NACOS_SERVER_ADDR=
NACOS_NAMESPACE_ID=
NACOS_SERVICE_NAME=woda-design-backend
NACOS_GROUP_NAME=DEFAULT_GROUP
NACOS_CLUSTER_NAME=DEFAULT
# 填其他服务器可达的 SDS-design 服务器 IP；端口默认使用上面的 HTTP_PORT。
# 注册的是 Nginx 代理的 /api 入口，不需要发布后端容器的 8957。
NACOS_INSTANCE_IP=
# 留空沿用 HTTP_PORT；通过其他端口/HTTPS 网关访问时填对应入口端口。
NACOS_INSTANCE_PORT=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_TLS_ENABLED=true
# 留空使用系统信任根；自签名 CA 须先挂载进 backend 容器，再填容器内路径。
NACOS_TLS_CA_FILE=
NACOS_TIMEOUT_SECONDS=10

# 默认在服务器构建；使用镜像仓库时把三个 IMAGE 改成对应的完整镜像地址和相同版本标签。
FRONTEND_IMAGE=woda-design-frontend:local
BACKEND_IMAGE=woda-design-backend:local
AGENT_IMAGE=woda-design-agent:local
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7-alpine

# 密码进入连接 URL：请使用 32 字节随机十六进制字符串，避免 @ : / # $ 等 URL 特殊字符。
# 生成命令：openssl rand -hex 32（每个密码、JWT 分别生成一次）。
DB_USER=woda
DB_NAME=woda_design
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET_KEY=
REDIS_KEY_PREFIX=woda:prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_TTL_SECONDS=604800
DESIGN_CACHE_TTL_SECONDS=604800

# 独立部署的 S3/RustFS 或支持 S3 API 的云对象存储，不在本 Compose 中启动存储集群。
# 该地址既用于后端请求，也用于生成浏览器下载链接，必须可被服务器和用户浏览器同时访问。
# 不可填写 http://objectstore:9000、localhost 或只能在容器内解析的服务名。
RUSTFS_ENDPOINT_URL=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=woda-design
RUSTFS_REGION=us-east-1
# 通常 RustFS/MinIO 用 path；其他供应商按其 S3 兼容说明配置 path 或 virtual。
RUSTFS_ADDRESSING_STYLE=path
RUSTFS_PRESIGNED_URL_EXPIRES_SECONDS=900
# 图片最大 25 MiB；PSD 最大 500 MiB，分片 8 MiB。Nginx 单次请求上限为 50 MiB。
RUSTFS_MAX_UPLOAD_BYTES=26214400
RUSTFS_MAX_PSD_UPLOAD_BYTES=524288000
RUSTFS_PSD_PART_SIZE=8388608
PSD_UPLOAD_SESSION_TTL_SECONDS=86400

# 对话模型需支持 tool calling，BASE_URL 填 API 根路径（如 /v1），不含具体接口路径。
AGENT_CHAT_BASE_URL=https://api.openai.com/v1
AGENT_CHAT_API_KEY=
AGENT_CHAT_MODEL=
AGENT_CHAT_TIMEOUT_SECONDS=60

# 生图服务需支持 POST /images/generations，可与对话使用不同供应商。
AGENT_IMAGE_BASE_URL=https://api.openai.com/v1
# 留空时复用 AGENT_CHAT_API_KEY。
AGENT_IMAGE_API_KEY=
AGENT_IMAGE_MODEL=
AGENT_IMAGE_SIZE=1024x1024
# 默认不发送 response_format；供应商有要求时填 url 或 b64_json。
AGENT_IMAGE_RESPONSE_FORMAT=
AGENT_IMAGE_TIMEOUT_SECONDS=180
# URL 返回需填写图片 CDN 主机名的 JSON 数组，例如 ["images.example.com"]；Base64 返回不需要。
AGENT_IMAGE_DOWNLOAD_ALLOWED_HOSTS=[]
AGENT_IMAGE_MAX_BYTES=26214400
AGENT_AUTH_TIMEOUT_SECONDS=5
AGENT_STORAGE_TIMEOUT_SECONDS=60

# Agent 单 worker、单副本运行；会话在内存中，重启丢失，额度在独立的持久化 Redis 中。
AGENT_QUOTA_KEY_PREFIX=woda:agent:quota
AGENT_MEMORY_TTL_SECONDS=3600
AGENT_MEMORY_MAX_CONVERSATIONS=1000
AGENT_MEMORY_MAX_TURNS=10
