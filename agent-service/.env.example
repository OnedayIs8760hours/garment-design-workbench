# OpenAI 兼容的 Chat Completions 接口，模型需要支持 tool calling。
AGENT_CHAT_BASE_URL=https://api.openai.com/v1
AGENT_CHAT_API_KEY=replace-with-chat-api-key
AGENT_CHAT_MODEL=replace-with-chat-model

# OpenAI 兼容的 POST /images/generations 接口，可以与对话使用不同供应商。
AGENT_IMAGE_BASE_URL=https://api.openai.com/v1
# 留空时复用对话 API Key。
AGENT_IMAGE_API_KEY=
AGENT_IMAGE_MODEL=replace-with-image-model
AGENT_IMAGE_SIZE=1024x1024
# 默认不发送 response_format；部分兼容服务可设为 url 或 b64_json。
AGENT_IMAGE_RESPONSE_FORMAT=
AGENT_IMAGE_TIMEOUT_SECONDS=180
AGENT_CHAT_TIMEOUT_SECONDS=60

# 复用主后端登录校验，不接收客户端传入的 user_id。
AGENT_AUTH_ME_URL=http://127.0.0.1:8957/api/auth/me
AGENT_ASSET_API_URL=http://127.0.0.1:8957/api/assets
AGENT_AUTH_TIMEOUT_SECONDS=5
# 返回 URL 的生图供应商需填写图片 CDN 主机名；Base64 返回不需要。
# 默认也允许 AGENT_IMAGE_BASE_URL 的同主机图片地址，不跟随重定向。
AGENT_IMAGE_DOWNLOAD_ALLOWED_HOSTS=[]
AGENT_STORAGE_TIMEOUT_SECONDS=60
AGENT_IMAGE_MAX_BYTES=26214400

# 只存额度，不存聊天内容。请与现有 Redis 的地址、密码一致。
AGENT_REDIS_URL=redis://:change-me@127.0.0.1:6379/0
AGENT_QUOTA_KEY_PREFIX=woda:agent:quota
# 每用户每天 5 次固定在业务层；按此时区的自然日重置。
AGENT_QUOTA_TIMEZONE=Asia/Shanghai

# 短期记忆仅存于当前进程，空闲超时后清理；只运行一个 worker。
AGENT_MEMORY_TTL_SECONDS=3600
AGENT_MEMORY_MAX_CONVERSATIONS=1000
AGENT_MEMORY_MAX_TURNS=10
AGENT_CORS_ORIGINS=["http://localhost:5000","http://127.0.0.1:5000"]
