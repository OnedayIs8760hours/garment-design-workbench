# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/oline_design

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret

# RustFS（S3 兼容 API）
RUSTFS_ENDPOINT_URL=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=replace-with-rustfs-access-key
RUSTFS_SECRET_KEY=replace-with-rustfs-secret-key
RUSTFS_BUCKET=woda-design
RUSTFS_REGION=us-east-1
RUSTFS_ADDRESSING_STYLE=path
RUSTFS_PRESIGNED_URL_EXPIRES_SECONDS=900
RUSTFS_MAX_UPLOAD_BYTES=26214400

# PSD 大文件分片上传
RUSTFS_MAX_PSD_UPLOAD_BYTES=524288000
RUSTFS_PSD_PART_SIZE=8388608
PSD_UPLOAD_SESSION_TTL_SECONDS=86400
