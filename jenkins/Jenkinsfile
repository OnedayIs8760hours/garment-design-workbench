// Jenkins 任务的 Script Path 设置为 jenkins/Jenkinsfile。
pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    timeout(time: 10, unit: 'MINUTES')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Verify pipeline') {
      steps {
        echo '代码拉取成功，Jenkins 基础流水线已跑通。'
      }
    }
  }
}
