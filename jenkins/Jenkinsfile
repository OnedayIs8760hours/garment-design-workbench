// Jenkins 任务的 Script Path 设置为 jenkins/Jenkinsfile。
// 在 Linux 执行节点的工作区自动准备 Node.js、uv 和 Python，无需 Docker 或 sudo。
pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '5'))
    timeout(time: 45, unit: 'MINUTES')
  }

  environment {
    CI = 'true'
    CI_NODE_VERSION = '22.23.4'
    CI_UV_VERSION = '0.13.6'
    SDS_DEPLOY_TARGET = 'root@38.22.234.43'
    SDS_DEPLOY_PORT = '22'
  }

  stages {
    stage('Checkout') {
      steps {
        // 拉取失败时也不能归档上一次的报告。
        dir('artifacts') {
          deleteDir()
        }
        script {
          def revision = checkout scm
          env.GIT_COMMIT = revision.GIT_COMMIT
          env.GIT_BRANCH = revision.GIT_BRANCH
        }
      }
    }

    stage('Prepare environment') {
      steps {
        script {
          if (!isUnix()) {
            error('当前流水线需要 Linux 执行节点。')
          }
        }
        sh 'bash jenkins/scripts/ci.sh check'
      }
    }

    stage('Frontend test and build') {
      steps {
        sh 'bash jenkins/scripts/ci.sh frontend'
      }
    }

    stage('Backend tests') {
      steps {
        sh 'bash jenkins/scripts/ci.sh backend'
      }
      post {
        always {
          script {
            if (fileExists('artifacts/backend-pytest.xml')) {
              junit testResults: 'artifacts/backend-pytest.xml'
            }
          }
        }
      }
    }

    stage('Agent tests and lint') {
      steps {
        sh 'bash jenkins/scripts/ci.sh agent'
      }
      post {
        always {
          script {
            if (fileExists('artifacts/agent-pytest.xml')) {
              junit testResults: 'artifacts/agent-pytest.xml'
            }
          }
        }
      }
    }

    stage('Archive frontend') {
      steps {
        archiveArtifacts artifacts: 'artifacts/frontend-dist.tar.gz', fingerprint: true
      }
    }

    stage('Deploy main') {
      when {
        expression { ['origin/main', 'main'].contains(env.GIT_BRANCH) }
      }
      steps {
        sh 'bash jenkins/scripts/deploy.sh'
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'artifacts/*-pytest.xml', allowEmptyArchive: true
    }
    success {
      echo '流水线通过：测试、构建和归档成功；main 分支已完成部署及线上检查，其他分支不部署。'
    }
    failure {
      echo 'CI 失败：请查看失败阶段的 Console Output 和测试报告。'
    }
    aborted {
      echo '构建已取消或超过 45 分钟，请查看 Console Output。'
    }
  }
}
